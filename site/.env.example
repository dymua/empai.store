# Змінні для збірки (Cloudflare Pages → Settings → Variables).
NEXT_PUBLIC_SITE_URL=https://empai.store
# Тестовий домен *.pages.dev: заборонити індексацію
NEXT_PUBLIC_NOINDEX=1
# Cloudflare Web Analytics (без cookie)
NEXT_PUBLIC_CF_BEACON_TOKEN=
# Google Analytics 4 (з банером згоди). На старому сайті був G-FF1Q8FBHXW
NEXT_PUBLIC_GA_ID=

# Секрети Pages Functions (не NEXT_PUBLIC!): форма → Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
